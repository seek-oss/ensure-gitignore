{
  "name": "ensure-gitignore",
  "version": "1.2.0",
  "description": "Ensure the presence of patterns within a project's gitignore",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "lint": "pnpm run '/^lint:.*/'",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "format": "pnpm run '/^format:.*/'",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "release": "changeset publish",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seek-oss/ensure-gitignore.git"
  },
  "author": "SEEK",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seek-oss/ensure-gitignore/issues"
  },
  "homepage": "https://github.com/seek-oss/ensure-gitignore#readme",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@tsconfig/node22": "^22.0.5",
    "eslint": "^9.39.2",
    "eslint-config-seek": "^15.0.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@10.25.0"
}
